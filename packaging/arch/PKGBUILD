# Moviko — movies and TV shows app for Arch Linux.
#
# Build & install from a checkout of this repository:
#     cd packaging/arch && makepkg -si      (after a git pull: makepkg -sif)
#
# The package is built straight from the checkout two levels up, so local
# changes are picked up without committing them.

# Moviko was called KumoBox before 2.0.9. KumoBox's own updater (2.0.8 and
# older) builds this with KUMOBOX_COMMIT set and installs the package named
# kumobox-*: built that way, the package keeps the old name (with Moviko in
# it), and Moviko's updater swaps it for the moviko package later. Otherwise
# the moviko package takes kumobox's place (pacman asks to remove kumobox).
if [[ -n ${KUMOBOX_COMMIT:-} && -z ${MOVIKO_COMMIT:-} ]]; then
    pkgname=kumobox
else
    pkgname=moviko
    provides=('kumobox')
    conflicts=('kumobox')
    replaces=('kumobox')
fi
pkgver=2.0.0
pkgrel=1
pkgdesc="Movies & TV shows: local library with auto matching, TMDB metadata, Letterboxd tracking, mpv & in-app player, streaming providers, torrents, extensions"
arch=('x86_64' 'aarch64')
url="https://github.com/v0-0x/kumobox-movies"
license=('GPL-3.0-or-later')
depends=('electron' 'mpv' 'ffmpeg' 'yt-dlp' 'hicolor-icon-theme' 'xdg-utils')
makedepends=('go' 'nodejs' 'npm')
optdepends=(
    'qbittorrent: torrent client (enable Tools › Options › Web UI)'
    'transmission-gtk: alternative torrent client (or transmission-cli for its daemon)'
    'discord: rich presence'
)
options=('!lto' '!debug' '!strip' '!buildflags') # pure Go (CGO off): makepkg's C/LD flags don't apply
install=moviko.install

_root="$(realpath "${startdir}/../..")"

# The version and commit go into the server, which compares them with
# GitHub's to offer updates (Home page). Moviko's updater builds a downloaded
# source, which has no .git: it passes them in MOVIKO_COMMIT and MOVIKO_VERSION.
# In a git checkout they come from git (version 2.0.<commits since 2.0.0's>,
# see desktop/package.json); otherwise, e.g. in an extracted source zip, the
# defaults stay. pkgver stays as it is on purpose: a pkgver() function would
# make makepkg rewrite this file in your checkout, and git pull would then
# stop on it.
build() {
    cd "${_root}"
    export GOFLAGS="-trimpath -mod=readonly -modcacherw"
    export CGO_ENABLED=0
    local commit="${MOVIKO_COMMIT:-${KUMOBOX_COMMIT:-}}" version="${MOVIKO_VERSION:-${KUMOBOX_VERSION:-}}" count
    if [[ ! -e "${_root}/.git" ]]; then
        # Not a checkout: Go mustn't stamp a git repository it's inside of
        # (e.g. a home folder kept in git).
        GOFLAGS+=" -buildvcs=false"
    elif command -v git >/dev/null; then
        [[ -n ${commit} ]] || commit="$(git -C "${_root}" rev-parse HEAD 2>/dev/null)" || commit=""
        if [[ -z ${version} ]] && count="$(git -C "${_root}" rev-list --count HEAD 2>/dev/null)"; then
            # Major.minor from desktop/package.json, and the commits since
            # the one its movikoVersionBase counts (2.0.0's).
            local pkg="${_root}/desktop/package.json" mm from
            mm="$(sed -n 's/^ *"version": *"\([0-9]*\.[0-9]*\)\..*/\1/p' "${pkg}")"
            from="$(sed -n 's/^ *"movikoVersionBase": *\([0-9]*\).*/\1/p' "${pkg}")"
            version="${mm:-1.0}.$((count - ${from:-0}))"
        fi
    fi
    local config=github.com/v0-0x/kumobox-movies/server/internal/config
    local ldflags="-s -w"
    [[ -z ${commit} ]] || ldflags+=" -X ${config}.Commit=${commit}"
    [[ -z ${version} ]] || ldflags+=" -X ${config}.AppVersion=${version}"
    make server GO_LDFLAGS="${ldflags}"
}

# The quick tests (Moviko's own updater skips them: --nocheck): the file name
# parser, the catalog, release names, Letterboxd, extensions, sharing between
# Movikos, the watch history they exchange, and the updater.
check() {
    cd "${_root}/server"
    go test ./internal/library/ ./internal/catalog/ ./internal/release/ ./internal/letterboxd/ ./internal/extensions/ ./internal/share/ ./internal/history/ ./internal/update/
}

package() {
    cd "${_root}"
    install -Dm755 dist/moviko "${pkgdir}/usr/lib/moviko/moviko"
    install -Dm644 desktop/main.js "${pkgdir}/usr/lib/moviko/app/main.js"
    install -Dm644 desktop/preload.js "${pkgdir}/usr/lib/moviko/app/preload.js"
    install -Dm644 desktop/package.json "${pkgdir}/usr/lib/moviko/app/package.json"
    install -Dm644 packaging/icons/moviko-512.png "${pkgdir}/usr/lib/moviko/app/icon.png"

    install -Dm755 packaging/moviko.sh "${pkgdir}/usr/bin/moviko"
    install -d "${pkgdir}/usr/bin"
    ln -s /usr/lib/moviko/moviko "${pkgdir}/usr/bin/moviko-server"
    # The old names, for what was set up before the rename: the menu entry
    # and autostart a desktop made (the app moves them to moviko when it
    # opens) and a running KumoBox restarting into the update.
    ln -s moviko "${pkgdir}/usr/bin/kumobox"
    ln -s moviko-server "${pkgdir}/usr/bin/kumobox-server"
    ln -s moviko "${pkgdir}/usr/lib/kumobox"

    install -Dm644 packaging/moviko.desktop "${pkgdir}/usr/share/applications/moviko.desktop"
    # The icon "moviko" (moviko.desktop's), in every size.
    local s
    for s in 16 32 48 64 128 256 512; do
        install -Dm644 "packaging/icons/moviko-${s}.png" "${pkgdir}/usr/share/icons/hicolor/${s}x${s}/apps/moviko.png"
    done
    install -Dm644 packaging/icons/moviko.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/moviko.svg"
    install -Dm644 packaging/moviko-server.service "${pkgdir}/usr/lib/systemd/user/moviko-server.service"
    # Its name before the rename, for a kumobox-server turned on back then (a
    # link: systemd takes it as another name for moviko-server).
    ln -s moviko-server.service "${pkgdir}/usr/lib/systemd/user/kumobox-server.service"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
